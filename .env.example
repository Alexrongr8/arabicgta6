# Copy to .env.local for local development. Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site
NEXT_PUBLIC_SITE_URL=https://arabicgta6.com
# Comma-separated Google emails that can open /admin (owner dashboard)
OWNER_EMAILS=

# Update + digest scripts (GitHub Actions secrets)
OPENAI_API_KEY=
# Must be set explicitly (no default). Cost-first proposal, not yet tested on this account:
OPENAI_MODEL=
OPENAI_RADAR_MODEL=
# Repo variables for the radar (GitHub → Settings → Variables). Unset = cheapest behaviour.
CONTENT_AUTOMATION_ENABLED=   # workflow only runs when exactly "true"
RADAR_BEAMS=web               # one beam; "all" = six beams (6x the calls)
UPDATE_MAX_ITEMS=1            # new articles per run (max 8)
ENRICH_PER_RUN=0              # rewrites of old articles per run (max 4)
RESEND_API_KEY=
DIGEST_FROM=Arabic GTA 6 <digest@arabicgta6.com>
SITE_URL=https://arabicgta6.com
